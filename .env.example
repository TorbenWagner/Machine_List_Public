# ---------------------------------------------------------------------------
# Datenbankverbindung (PostgreSQL, z. B. Supabase oder lokales Docker-Postgres)
# Format: postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://machine_list:machine_list@localhost:5432/machine_list

# Separate Datenbank fuer automatisierte Tests (wird bei jedem Testlauf
# migriert; Inhalte werden von den Tests verwaendert/geloescht).
TEST_DATABASE_URL=postgres://machine_list:machine_list@localhost:5432/machine_list_test

# ---------------------------------------------------------------------------
# Oeffentliche Basis-URL der Anwendung. Wird zur Erzeugung der QR-Code-Ziel-
# adressen ({PUBLIC_BASE_URL}/m/{qrToken}) verwendet.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Administrator-Zugang (genau ein Administrator im MVP)
# ADMIN_PASSWORD_HASH wird mit "npm run create-password-hash -- <Passwort>"
# erzeugt. Niemals ein Klartextpasswort hier eintragen.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Zufaelliger, geheimer Schluessel zum Signieren der Admin-Session (mind. 32
# Zeichen). Lokal generierbar z. B. mit: openssl rand -base64 48
SESSION_SECRET=
